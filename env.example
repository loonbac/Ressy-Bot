# Template only. Keep real credentials out of version control.

# --- Discord bot ---
# The bot user ID is derived from the token via GET /users/@me; no app ID needed.
DISCORD_BOT_TOKEN=

# --- Admin panel OAuth ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
RESSY_SESSION_SECRET=
RESSY_ADMIN_IDS=
RESSY_PANEL_REDIRECT=

# --- Lavalink ---
LAVALINK_PASSWORD=

# --- Optional runtime overrides ---
RESSY_PANEL_ADDR=
RESSY_PLUGIN_DIR=
RESSY_SETTINGS_PATH=
RESSY_LAVALINK_URL=

# In Docker, the entrypoint derives RESSY_LAVALINK_PASSWORD from
# LAVALINK_PASSWORD.
